# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/file_storage?schema=public

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Storage
STORAGE_LIMIT_GB=10          # initial total limit (used only when the storage config row is first created)
MAX_FILE_SIZE_MB=5120        # per-file limit; 5120 MB = S3 single PUT maximum

# Presigned URL lifetimes (seconds)
UPLOAD_URL_EXPIRES_SECONDS=900
DOWNLOAD_URL_EXPIRES_SECONDS=300

# How often stale upload reservations are released (minutes)
CLEANUP_INTERVAL_MINUTES=5

# Allowed CORS origins (comma-separated)
FRONTEND_URL=http://localhost:5173
